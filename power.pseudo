
//unoptimized solution for pow non working 1st iteration

fn pow_unoptimized(base: u64, exp: u64) -> u64 {
    if exp == 0 {
        return 1;
    }
    let mut result = 1;
    for _i in 0..exp {
        result *= base;
    }
    return result;
}



//second iteration


fn pow(base: u64, mut exp: u64) -> u64 {
    if exp == 0 {
        return 1;
    }
    let mut cur_base: u64 = 1;
    let mut res = base;
    let mut end_result = 1;
    while exp != 0 {
        while !cur_base.checked_mul(2).is_none() && (exp >= cur_base * 2)
        //make sure that the next cur base doesnt go above the exp
        // # or overflow of cur base
        {
            res = res * res; //calculates the base^(2*2*2...)
            cur_base = cur_base * 2;
        }

        end_result *= res;
        exp = exp % cur_base;
        cur_base = 1;
        res = base;
    }
    end_result
}
